# Скопируй этот файл в .env и впиши свой ключ OpenRouter.
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Необязательно: порт локального сервера (по умолчанию 3000)
# PORT=3000

# Необязательно: доступ к игре с телефона или другого компьютера в той же сети.
# По умолчанию игра открывается только на этом компьютере. Чтобы открыть её из локальной сети,
# раскомментируй обе строки и придумай пароль — без пароля доступ из сети не откроется.
# На телефоне открой адрес, который сервер напечатает при запуске; имя пользователя любое.
# LAN_ACCESS=1
# LAN_PASSWORD=

# Необязательно: сколько секунд ждать ответа модели на один запрос (по умолчанию 240).
# Ход можно прервать и раньше — кнопкой «прервать» под индикатором ожидания.
# REQUEST_TIMEOUT_MS=240000
