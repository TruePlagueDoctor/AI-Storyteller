{
  "name": "ai-storyteller",
  "version": "0.1.0",
  "description": "Текстовая RPG с ИИ-рассказчиком через OpenRouter: живые листы героев и НПС, черты характера, броски, лорбук, сохранения и проверка на противоречия.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --import ./test/setup.js --test",
    "test:ui": "node scripts/ui-smoke.mjs",
    "eval:sync": "node scripts/eval-sync.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
